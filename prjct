package demo

data class Student(
    val name: String,
    var age: Int,
    val group: String,
    var course: Int
) {
    override fun toString(): String = "$name, $age лет, $group, курс $course"
}

class StudentManager(students: MutableList<Student>) {
    private val students = students.toMutableList() // копия для инкапсуляции

    fun showStudents() {
        if (students.isEmpty()) {
            println("Список студентов пуст.")
            return
        }
        students.forEach { println(it) }
    }

    fun addStudent(student: Student) {
        students.add(student)
        println("Студент добавлен.")
    }

    fun findStudent(name: String): Student? =
        students.find { it.name.equals(name, ignoreCase = true) }

    fun showAdults() {
        val adults = students.filter { it.age >= 18 }
        if (adults.isEmpty()) {
            println("Совершеннолетних студентов нет.")
        } else {
            adults.forEach { println(it) }
        }
    }

    fun removeStudent(name: String): Boolean =
        students.removeIf { it.name.equals(name, ignoreCase = true) }
}

private fun prompt(msg: String): String? {
    print(msg)
    return readLine()?.trim()
}

fun main() {
    val initial = mutableListOf(
        Student("Андрей", 18, "ИТ-101", 1),
        Student("Иван", 19, "ИТ-101", 1),
        Student("Анна", 20, "ИТ-102", 2),
        Student("Максим", 17, "ИТ-103", 1)
    )

    val manager = StudentManager(initial)

    menu@ while (true) {
        println(
            """
            
            === STUDENT MANAGER ===
            1. Показать студентов
            2. Добавить студента
            3. Найти студента
            4. Показать совершеннолетних
            5. Удалить студента
            0. Выход
            """.trimIndent()
        )

        when (prompt(">")) {
            "1" -> manager.showStudents()
            "2" -> {
                val name = prompt("Имя:").orEmpty()
                if (name.isBlank()) { println("Имя не может быть пустым."); continue@menu }

                val age = prompt("Возраст:")?.toIntOrNull()
                if (age == null) { println("Некорректный возраст."); continue@menu }

                val group = prompt("Группа:").orEmpty()
                if (group.isBlank()) { println("Группа не может быть пустой."); continue@menu }

                val course = prompt("Курс:")?.toIntOrNull()
                if (course == null) { println("Некорректный курс."); continue@menu }

                manager.addStudent(Student(name, age, group, course))
            }
            "3" -> {
                val name = prompt("Имя:").orEmpty()
                if (name.isBlank()) { println("Имя не может быть пустым."); continue@menu }

                val student = manager.findStudent(name)
                println(student ?: "Студент не найден")
            }
            "4" -> manager.showAdults()
            "5" -> {
                val name = prompt("Имя:").orEmpty()
                if (name.isBlank()) { println("Имя не может быть пустым."); continue@menu }

                val removed = manager.removeStudent(name)
                println(if (removed) "Студент удалён." else "Студент не найден.")
            }
            "0" -> break@menu
            else -> println("Неверная команда")
        }
    }
}
