year = int(input())

a = year % 19
b = year % 4
c = year % 7

k = year // 100
p = (13 + 8 * k) // 25
q = k // 4

M = (15 - p + k - q) % 30
N = (4 + k - q) % 7

d = (19 * a + M) % 30
e = (2 * b + 4 * c + 6 * d + N) % 7

if d == 29 and e == 6:
    day = 19
    month = "апреля"
elif d == 28 and e == 6 and ((11 * M + 11) % 30) < 19:
    day = 18
    month = "апреля"
else:
    if 22 + d + e <= 31:
        day = 22 + d + e
        month = "марта"
    else:
        day = d + e - 9
        month = "апреля"

print(f"Пасха в {year} году будет {day} {month}.")
